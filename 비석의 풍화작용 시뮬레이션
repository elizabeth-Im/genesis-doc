<canvas id="weatheringCanvas" width="600" height="400"></canvas>
<script>
const canvas = document.getElementById("weatheringCanvas");
const ctx = canvas.getContext("2d");

let time = 0;

// 비석 초기 모양
const tombstone = {
  x: 250,
  y: 100,
  width: 100,
  height: 200,
  erosion: 0
};

function drawTombstone() {
  ctx.fillStyle = `rgb(${100 + tombstone.erosion}, ${100 - tombstone.erosion}, ${100 - tombstone.erosion})`;
  ctx.fillRect(tombstone.x, tombstone.y, tombstone.width, tombstone.height);
}

function drawWindParticles() {
  for (let i = 0; i < 30; i++) {
    const x = (time * 3 + i * 20) % canvas.width;
    const y = 150 + Math.sin(x * 0.05 + time * 0.05) * 30;
    ctx.fillStyle = "rgba(200,200,255,0.3)";
    ctx.beginPath();
    ctx.arc(x, y, 2, 0, 2 * Math.PI);
    ctx.fill();
  }
}

function updateErosion() {
  if (tombstone.erosion < 100) {
    tombstone.erosion += 0.1;
  }
}

function draw() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  drawTombstone();
  drawWindParticles();
  updateErosion();
  time++;
  requestAnimationFrame(draw);
}

draw();
</script>
